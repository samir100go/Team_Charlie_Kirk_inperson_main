# JALANI configuration. Copy to .env with `make .env` (fills every secret with a random
# value) or by hand. docker-compose.yml reads this file; services read the same names
# from their environment. Required secrets are blank on purpose: compose refuses to start
# ("set X in .env") and each service fails fast with the variable name if one is missing.

# --- Simulator (organizer image, never modified) -----------------------------------------
SIMULATOR_IMAGE=asifmahmoud414/bup-fuel-supply-simulator:1.0.0
# Wall-clock ticks per second while RUNNING (8 = default; measures ~7.2 ticks/s).
SIMULATION_SPEED=8
# Simulated minutes per tick.
TICK_MINUTES=15
# paused | running
SIMULATOR_START_MODE=paused
# Speed used by `make demo` (docker-compose.override.demo.yml).
DEMO_SPEED=2

# --- Postgres -------------------------------------------------------------------------------
POSTGRES_USER=jalani
# REQUIRED secret.
POSTGRES_PASSWORD=
POSTGRES_DB=jalani

# --- Services (ingestor, intelligence, core-api) --------------------------------------------
# Composed in docker-compose.yml from the values above; set these only when running a
# service outside Docker (`uv run uvicorn core_api.main:create --factory`):
#   SIMULATOR_URL=http://localhost:8000
#   DATABASE_URL=postgresql://jalani:<password>@localhost:5432/jalani
#   REDIS_URL=redis://localhost:6379/0
#   INTELLIGENCE_URL=http://localhost:8090
LOG_LEVEL=INFO
# /readyz probe timeout per dependency, seconds.
READINESS_TIMEOUT_S=2
# Enables the resilience-demo triggers (/api/v1/chaos/*, admin role only) and the
# prediction-service outage switch. Set false to remove them entirely.
CHAOS_ENABLED=true
# ingestor: polling fallback cadence when SSE is unavailable.
POLL_INTERVAL_MS=500

# --- core-api -------------------------------------------------------------------------------
# Host port for core-api (container always listens on 8080). Change it if 8080 is taken.
CORE_API_PORT=8080
# REQUIRED secret, at least 32 characters.
JWT_SECRET=
# Console logins: `operator` approves allocations; `admin` also triggers resilience demos.
# REQUIRED secrets, at least 12 characters.
OPERATOR_PASSWORD=
ADMIN_PASSWORD=
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000
AUTOPILOT_ENABLED=true

# --- Copilot (Phase 14, not used yet) -------------------------------------------------------
# ANTHROPIC_API_KEY=

# --- Grafana --------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# REQUIRED secret.
GRAFANA_ADMIN_PASSWORD=

# --- Build metadata (set by `make`, shown on /version) --------------------------------------
# GIT_SHA=
# BUILD_TIME=
IMAGE_TAG=dev
