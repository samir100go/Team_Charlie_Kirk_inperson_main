              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "data age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 3
                    },
                    {
                      "color": "red",
                      "value": 10
                    }
                  ]
                }
              }
